d":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The property’s name. Required, and trimmed of surrounding whitespace before it"},{"type":"text","text":" "},{"type":"text","text":"is stored — a property is always named, and the SDK does not substitute a placeholder."}],"type":"paragraph"}],"name":"name"},{"content":[{"inlineContent":[{"type":"text","text":"How many floors to seed, clamped to at least one — a property with no"},{"type":"text","text":" "},{"type":"text","text":"floor has nothing to capture. Defaults to a single floor, which is the right call for a"},{"type":"text","text":" "},{"type":"text","text":"host that does not know the building’s floor count: the seed is a starting point, not a"},{"type":"text","text":" "},{"type":"text","text":"limit, and the user adds floors as they go — from the floor screen while the property"},{"type":"text","text":" "},{"type":"text","text":"still has one floor, and from the property screen once it has more."}],"type":"paragraph"}],"name":"floorCount"},{"content":[{"inlineContent":[{"type":"text","text":"Any "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":" that encodes to a JSON object, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for none."}],"type":"paragraph"}],"name":"metadata"}]},{"content":[{"text":"Return Value","type":"heading","anchor":"return-value","level":2},{"inlineContent":[{"text":"A handle to the new property.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"mentions":["doc:\/\/noughtytourssdk.NoughtyToursSDK\/documentation\/NoughtyToursSDK\/GettingStarted"],"kind":"mentions"},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"inlineContent":[{"text":"The property-list screen offers the same thing to the user; this is the entry point for a","type":"text"},{"text":" ","type":"text"},{"text":"host that already knows what it wants to capture — a work order, a project, a job — and","type":"text"},{"text":" ","type":"text"},{"text":"opens ","type":"text"},{"isActive":true,"identifier":"doc:\/\/noughtytourssdk.NoughtyToursSDK\/documentation\/NoughtyToursSDK\/PropertyManagement\/makePropertyViewController(property:onEvent:)","type":"reference"},{"text":" on it directly, without the list.","type":"text"},{"text":" ","type":"text"},{"text":"The returned handle is a vended one: pass it straight into a factory, and store its","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/noughtytourssdk.NoughtyToursSDK\/documentation\/NoughtyToursSDK\/Property\/id","type":"reference"},{"text":" if the host needs to find the same property again on a later launch","type":"text"},{"text":" ","type":"text"},{"text":"(see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/noughtytourssdk.NoughtyToursSDK\/documentation\/NoughtyToursSDK\/PropertyManagement\/property(id:)","type":"reference"},{"text":").","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"metadata","type":"codeVoice"},{"text":" attaches the host’s own record to the tour — the work-order number, project id,","type":"text"},{"text":" ","type":"text"},{"text":"or whatever it keys its own rows by. Pass any ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":" that encodes to a JSON object;","type":"text"},{"text":" ","type":"text"},{"text":"the SDK serializes it once, here, and stores it alongside the property:","type":"text"}],"type":"paragraph"},{"code":["struct JobRef: Encodable {","    let jobId: String","    let priority: Int","}","","let property = try await core.properties.createProperty(","    name: \"12 Oak Street\",","    floorCount: 2,","    metadata: JobRef(jobId: \"WO-4471\", priority: 2)",")"],"type":"codeListing","syntax":"swift"},{"content":[{"inlineContent":[{"type":"text","text":"Metadata is "},{"type":"strong","inlineContent":[{"type":"text","text":"set once, here"}]},{"type":"text","text":". The SDK API accepts it only on the request"},{"type":"text","text":" "},{"type":"text","text":"that creates the tour, so there is no way — through this SDK or any other client — to"},{"type":"text","text":" "},{"type":"text","text":"add or change it afterwards, and a property created without it never gets any."}],"type":"paragraph"}],"type":"aside","style":"important","name":"Important"},{"inlineContent":[{"text":"The backend owns what it will accept — size, key count, nesting depth — and rejects an","type":"text"},{"text":" ","type":"text"},{"text":"unacceptable blob when the tour is created, which surfaces as a failed sync rather than a","type":"text"},{"text":" ","type":"text"},{"text":"failure here. The SDK checks only that the value encodes to a JSON object, since anything","type":"text"},{"text":" ","type":"text"},{"text":"else has no place in the request at all.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/noughtytourssdk.NoughtyToursSDK\/documentation\/NoughtyToursSDK\/NoughtyToursError\/invalidName(reason:)","isActive":true},{"type":"text","text":" if "},{"type":"codeVoice","code":"name"},{"type":"text","text":" is empty or nothing but"},{"type":"text","text":" "},{"type":"text","text":"whitespace, and "},{"type":"reference","identifier":"doc:\/\/noughtytourssdk.NoughtyToursSDK\/documentation\/NoughtyToursSDK\/NoughtyToursError\/invalidMetadata(reason:)","isActive":true},{"type":"text","text":" if "},{"type":"codeVoice","code":"metadata"},{"type":"text","text":" does not"},{"type":"text","text":" "},{"type":"text","text":"encode to a JSON object — in both cases nothing is written, and retrying the same value"},{"type":"text","text":" "},{"type":"text","text":"fails identically."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/noughtytourssdk.NoughtyToursSDK\/documentation\/NoughtyToursSDK\/NoughtyToursError\/storageFailure(reason:)","isActive":true},{"type":"text","text":" if the write failed, which is"},{"type":"text","text":" "},{"type":"text","text":"worth retrying; a failure part-way through floor seeding leaves the property created with"},{"type":"text","text":" "},{"type":"text","text":"fewer floors than asked for, exactly as the list screen’s own create does."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/noughtytourssdk.NoughtyToursSDK\/documentation\/NoughtyToursSDK\/NoughtyToursError\/storageUnavailable(reason:)","isActive":true},{"type":"text","text":" if the core had not been started and"},{"type":"text","text":" "},{"type":"text","text":"starting it here failed."}],"type":"paragraph"}],"type":"aside","style":"note","name":"Throws"}],"kind":"content"}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/noughtytourssdk\/propertymanagement\/createproperty(name:floorcount:metadata:)"]}],"abstract":[{"text":"Creates a property and seeds it with ","type":"text"},{"code":"floorCount","type":"codeVoice"},{"text":" floors, numbered from 1.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","metadata":{"externalID":"s:15NoughtyToursSDK18PropertyManagementV06createD04name10floorCount8metadataAA0D0VSS_SiSE_pSgtYaAA0aB5ErrorOYKF","modules":[{"name":"NoughtyTours SDK"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"createProperty","kind":"identifier"},{"text":"(","kind":"text"},{"text":"name","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"floorCount","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"metadata","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"any","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Encodable","kind":"typeIdentifier","preciseIdentifier":"s:SE"},{"text":")?) ","kind":"text"