tent":[{"type":"text","text":"show the message."}],"type":"strong"},{"text":" The ","type":"text"},{"code":"reason","type":"codeVoice"},{"text":" strings are diagnostics whose","type":"text"},{"text":" ","type":"text"},{"text":"wording changes between versions, so never branch on them. New cases arrive in minor versions, so","type":"text"},{"text":" ","type":"text"},{"text":"keep a ","type":"text"},{"code":"default","type":"codeVoice"},{"text":" in exhaustive switches.","type":"text"}]}],"type":"aside","style":"important","name":"Important"},{"text":"Codes are API, messages are not","type":"heading","anchor":"Codes-are-API-messages-are-not","level":3},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/noughtytourssdk.NoughtyToursSDK\/documentation\/NoughtyToursSDK\/NoughtyToursError\/code","isActive":true},{"type":"text","text":" is a stable, machine-readable identifier for the failure: lowercase,"},{"type":"text","text":" "},{"type":"codeVoice","code":"."},{"type":"text","text":"-separated, and never reused for a different meaning. It is what belongs in a log line, a support"},{"type":"text","text":" "},{"type":"text","text":"ticket, or a payload to your own backend — every place where "},{"type":"reference","identifier":"doc:\/\/noughtytourssdk.NoughtyToursSDK\/documentation\/NoughtyToursSDK\/NoughtyToursError\/description","isActive":true},{"type":"text","text":" would"},{"type":"text","text":" "},{"type":"text","text":"rot the moment someone rewords it."}],"type":"paragraph"},{"code":["} catch {","    logger.error(\"capture failed: \\(error.code, privacy: .public) — \\(error)\")","    reporting.record(failure: error.code)    \/\/ \"upload_failed\", \"auth.keychain_failure\"","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"A new case brings a new code, so a code you have already seen keeps its meaning across versions —"},{"type":"text","text":" "},{"type":"text","text":"treat one you do not recognise as unhandled rather than guessing at its shape."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/noughtytourssdk.NoughtyToursSDK\/documentation\/NoughtyToursSDK\/NoughtyToursError\/auth(_:)","isActive":true},{"type":"text","text":" nests the wrapped code behind an "},{"type":"codeVoice","code":"auth."},{"type":"text","text":" prefix, which keeps the auth"},{"type":"text","text":" "},{"type":"text","text":"failures greppable as one family: "},{"type":"codeVoice","code":"auth.keychain_failure"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/noughtytourssdk.NoughtyToursSDK\/documentation\/NoughtyToursSDK\/AuthError\/keychainFailure(status:)","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Both properties carry the full table of codes: "},{"type":"reference","identifier":"doc:\/\/noughtytourssdk.NoughtyToursSDK\/documentation\/NoughtyToursSDK\/NoughtyToursError\/code","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/noughtytourssdk.NoughtyToursSDK\/documentation\/NoughtyToursSDK\/AuthError\/code","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Uploads retry themselves","type":"heading","anchor":"Uploads-retry-themselves","level":3},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/noughtytourssdk.NoughtyToursSDK\/documentation\/NoughtyToursSDK\/NoughtyToursError\/isRetryable","isActive":true},{"type":"text","text":" says whether "},{"type":"emphasis","inlineContent":[{"text":"this","type":"text"}]},{"type":"text","text":" call could succeed on a second attempt. It is"},{"type":"text","text":" "},{"type":"text","text":"not a cue to build an upload loop: captured artifacts go into a durable queue that survives the app"},{"type":"text","text":" "},{"type":"text","text":"being suspended or killed, and each item is retried automatically up to three times, resuming on the"},{"type":"text","text":" "},{"type":"text","text":"next launch or background wake-up. An item that exhausts its attempts stays failed — and stays"},{"type":"text","text":" "},{"type":"text","text":"visible as such in the screens the SDK vends — until the user taps sync again, which forgives the"},{"type":"text","text":" "},{"type":"text","text":"counters and re-drains the queue. Retrying on top of that only duplicates work already in flight."}],"type":"paragraph"},{"text":"Where errors reach you","type":"heading","anchor":"Where-errors-reach-you","level":3},{"inlineContent":[{"type":"text","text":"Two paths, and they mean different things:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Thrown","type":"text"}]},{"type":"text","text":" from a factory, before you have a screen — the entity was gone, the read failed, or"},{"type":"text","text":" "},{"type":"text","text":"the device can’t capture. There is nothing on screen yet, so you decide what to show."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Reported","type":"text"}]},{"type":"text","text":" through a screen’s "},{"type":"codeVoice","code":"onEvent"},{"type":"text","text":" "},{"type":"codeVoice","code":"failed"},{"type":"text","text":" case — a write the screen performed on its"},{"type":"text","text":" "},{"type":"text","text":"own failed while the user was looking at it. The screen has already dismissed anything it was"},{"text":" ","type":"text"},{"text":"presenting; the SDK does not put up an alert.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Auth failures worth special handling","type":"heading","anchor":"Auth-failures-worth-special-handling","level":3},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/noughtytourssdk.NoughtyToursSDK\/documentation\/NoughtyToursSDK\/AuthError\/appAttestUnavailable","isActive":true},{"type":"text","text":" means th