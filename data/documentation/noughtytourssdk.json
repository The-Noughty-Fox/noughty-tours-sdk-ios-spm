n\/noughtytourssdk"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"inlineContent":[{"text":"Your users create a property, walk it to map its floor plan, capture panoramas room by room, and","type":"text"},{"text":" ","type":"text"},{"text":"everything is stored locally and uploaded in the background. You add one package, write one","type":"text"},{"text":" ","type":"text"},{"text":"import, and push the screens the SDK vends onto your own navigation stack.","type":"text"}],"type":"paragraph"},{"code":["import NoughtyToursSDK"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The SDK owns the domain (property → floor → room → panorama scan), the capture runtimes, local","type":"text"},{"text":" ","type":"text"},{"text":"storage, and sync. You own navigation, your login, and your chrome.","type":"text"}],"type":"paragraph"},{"text":"Requirements","type":"heading","anchor":"Requirements","level":3},{"type":"table","alignments":["left","left"],"header":"row","rows":[[[{"inlineContent":[],"type":"paragraph"}],[{"inlineContent":[],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Platform"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"iOS 17+"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Devices"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"a real device with a LiDAR scanner for anything that captures or syncs — check "},{"type":"reference","isActive":true,"identifier":"doc:\/\/noughtytourssdk.NoughtyToursSDK\/documentation\/NoughtyToursSDK\/NoughtyTours\/isDeviceSupported"},{"type":"text","text":" before offering capture"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Architectures"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"arm64 only: device + Apple-silicon simulator slices"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Capabilities"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"App Attest on your own App ID, plus "},{"type":"codeVoice","code":"NSCameraUsageDescription"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Backend"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"a "},{"type":"codeVoice","code":"pk_ios_*"},{"type":"text","text":" publishable key issued to "},{"type":"emphasis","inlineContent":[{"type":"text","text":"your"}]},{"type":"text","text":" app by The Noughty Fox"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Localization"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"en"},{"type":"text","text":", "},{"type":"codeVoice","code":"de"},{"type":"text","text":", "},{"type":"codeVoice","code":"ro"},{"type":"text","text":", "},{"type":"codeVoice","code":"ru"},{"type":"text","text":" — the screens localize themselves; there is no string-override hook"}],"type":"paragraph"}]]]},{"text":"Getting started","type":"heading","anchor":"Getting-started","level":3},{"inlineContent":[{"text":"Setting the SDK up is two jobs, and the first one is not code: the device authenticates itself","type":"text"},{"text":" ","type":"text"},{"text":"against ","type":"text"},{"inlineContent":[{"type":"text","text":"your"}],"type":"emphasis"},{"text":" App ID, so ","type":"text"},{"isActive":true,"identifier":"doc:\/\/noughtytourssdk.NoughtyToursSDK\/documentation\/NoughtyToursSDK\/AppAttest","type":"reference"},{"text":" has to be done before anything syncs. Then","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/noughtytourssdk.NoughtyToursSDK\/documentation\/NoughtyToursSDK\/GettingStarted","type":"reference"},{"text":" walks the integration end to end — providers, the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/noughtytourssdk.NoughtyToursSDK\/documentation\/NoughtyToursSDK\/NoughtyTours","type":"reference"},{"text":" instance,","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/noughtytourssdk.NoughtyToursSDK\/documentation\/NoughtyToursSDK\/NoughtyTours\/start()","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/noughtytourssdk.NoughtyToursSDK\/documentation\/NoughtyToursSDK\/NoughtyTours\/prepareDeviceAuth()","type":"reference"},{"text":", and the screens.","type":"text"}],"type":"paragraph"},{"text":"What this SDK does not do","type":"heading","anchor":"What-this-SDK-does-not-do","level":3},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"It has no opinion about your users.","type":"text"}],"type":"strong"},{"type":"text","text":" There is no login here. You authenticate your users"},{"type":"text","text":" "},{"type":"text","text":"your own way and hand the SDK only the selected organisation, through"},{"type":"text","text":" "},{"identifier":"doc:\/\/noughtytourssdk.NoughtyToursSDK\/documentation\/NoughtyToursSDK\/OrganizationProviderType","type":"reference","isActive":true},{"type":"text","text":". The SDK’s own auth is device-level and separate."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"It stores no settings.","type":"text"}],"type":"strong"},{"type":"text","text":" It never touches "},{"code":"UserDefaults","type":"codeVoice"},{"type":"text","text":"; every knob comes from you through"},{"type":"text","text":" "},{"identifier":"doc:\/\/noughtytourssdk.NoughtyToursSDK\/documentation\/NoughtyToursSDK\/SettingsProviderType","type":"reference","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"It presents nothing on its own"}],"type":"strong"},{"type":"text","text":" — no alerts, no modals over your stack. Failures arrive"},{"type":"text","text":" "},{"type":"text","text":"through an "},{"type":"codeVoice","code":"onEvent"},{"type":"text","text":" "},{"type":"codeVoice","code":"failed"},{"type":"text","text":" case or are thrown as "},{"identifier":"doc:\/\/noughtytourssdk.NoughtyToursSDK\/documentation\/NoughtyToursSDK\/NoughtyToursError","type":"reference","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"It is offline-first.","type":"text"}]},{"text":" Capture never blocks on connectivity; uploads and sync are additive","type":"text"},{"type":"text","text":" "},{"text":"and happen in the background.","type":"text"}]}]}],"type":"unorderedList"}],"kind":"content"}],"references":{"doc://noughtytourssdk.NoughtyToursSDK/documentation/NoughtyToursSDK/NoughtyTours/start()":{"identifier":"doc:\/\/noughtytourssdk.NoughtyToursSDK\/documentation\/NoughtyToursSDK\/NoughtyTours\/start()","url":"\/documentation\/noughtytourssdk\/noughtytours\/start()","type":"topic","title":"start()","abstract":[{"type":"text","text":"Prepares local storage and the upload machinery: prunes orphaned SDK folders from earlier"},{"type":"text","text":" "},{"type":"text","text":"versions, opens and migrates the SQLite database, and reconnects the background upload"},{"type":"text","text":" "},{"type":"text","text":"session to any transfers still in flight from a previous launch."}],"role":"symbol","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"start"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"preciseIdentifier":"s:15NoughtyToursSDK0aB5ErrorO","kind":"typeIdentifier","text":"NoughtyToursError"},{"text":")","kind":"text"}]},"doc://noughtytourssdk.NoughtyToursSDK/documentation/NoughtyToursSDK/NoughtyTours":{"type":"topic","kind":"symbol","url":"\/documentation\/noughtytourssdk\/noughtytours","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NoughtyTour